# Copy to .env and adjust. Only CAPSA_DOMAIN is required.

# Host name the app is served on (TLS is terminated by Traefik).
CAPSA_DOMAIN=capsa.example.org

# Traefik: HTTPS entrypoint and the container network Traefik uses to reach services.
#TRAEFIK_ENTRYPOINT=websecure
#TRAEFIK_NETWORK=traefik

# Folder with the profile YAML files (mounted read-only; changes are picked up live).
#CAPSA_PROFILE_DIR=./profiles

# Name of this instance: prefixes container, router and volume names, so several
# instances (e.g. a test instance) can run side by side.
#CAPSA_INSTANCE=capsa

# Proxy addresses whose X-Forwarded-For header is trusted (see compose.yaml).
#CAPSA_TRUSTED_PROXIES=*

# Image tag to build/run. Set it to the release (contents of VERSION, e.g. 2026.11):
# `podman compose up -d` then builds the images by itself whenever the tag changes,
# so an update is: check out the new release, set the new tag here, start again.
#CAPSA_VERSION=latest

# Capsa checkout the images are built from (default: the repository this file is in).
# Set it when compose.yaml is copied into a separate service folder.
#CAPSA_SOURCE=../..
