{
  "openapi": "3.1.0",
  "info": {
    "title": "Capsa API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Health",
        "description": "Liveness check for the container runtime and the reverse proxy.",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Login",
        "operationId": "login_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials"
          },
          "429": {
            "description": "Too many"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Logout",
        "operationId": "logout_api_v1_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Me",
        "operationId": "me_api_v1_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me/password": {
      "put": {
        "tags": [
          "auth"
        ],
        "summary": "Change Password",
        "operationId": "change_password_api_v1_me_password_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordChange"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "400": {
            "description": "Policy"
          },
          "403": {
            "description": "Wrong current password"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/profiles": {
      "get": {
        "tags": [
          "profiles"
        ],
        "summary": "List Profiles",
        "operationId": "list_profiles_api_v1_profiles_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ProfileSummary"
                  },
                  "type": "array",
                  "title": "Response List Profiles Api V1 Profiles Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/profiles/{profile_id}": {
      "get": {
        "tags": [
          "profiles"
        ],
        "summary": "Get Profile",
        "operationId": "get_profile_api_v1_profiles__profile_id__get",
        "parameters": [
          {
            "name": "profile_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Profile Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The profile document (see schemas/profile.schema.json).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "304": {
            "description": "Not modified (If-None-Match matched the ETag)."
          },
          "404": {
            "description": "No such profile, or not released to this account."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sync/events": {
      "post": {
        "tags": [
          "sync"
        ],
        "summary": "Upload Events",
        "operationId": "upload_events_api_v1_sync_events_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EventBatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "sync"
        ],
        "summary": "Download Events",
        "operationId": "download_events_api_v1_sync_events_get",
        "parameters": [
          {
            "name": "since",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "description": "last server_seq already known",
              "default": 0,
              "title": "Since"
            },
            "description": "last server_seq already known"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 500,
              "minimum": 1,
              "default": 500,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventPage"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/settings": {
      "get": {
        "tags": [
          "settings"
        ],
        "summary": "List Settings",
        "operationId": "list_settings_api_v1_settings_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Setting"
                  },
                  "type": "array",
                  "title": "Response List Settings Api V1 Settings Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/settings/{key}": {
      "get": {
        "tags": [
          "settings"
        ],
        "summary": "Get Setting",
        "operationId": "get_setting_api_v1_settings__key__get",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9_.-]{1,64}$",
              "title": "Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Setting"
                }
              }
            }
          },
          "404": {
            "description": "Not set"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "settings"
        ],
        "summary": "Put Setting",
        "description": "Store the value if it is newer than the stored one; return the winning value.",
        "operationId": "put_setting_api_v1_settings__key__put",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9_.-]{1,64}$",
              "title": "Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SettingWrite"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Setting"
                }
              }
            }
          },
          "400": {
            "description": "Invalid value for this key"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/users": {
      "get": {
        "tags": [
          "admin"
        ],
        "summary": "List Users",
        "operationId": "list_users_api_v1_admin_users_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/UserInfo"
                  },
                  "type": "array",
                  "title": "Response List Users Api V1 Admin Users Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "admin"
        ],
        "summary": "Create User",
        "operationId": "create_user_api_v1_admin_users_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserInfo"
                }
              }
            }
          },
          "400": {
            "description": "Invalid username/password/profiles"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/users/{user_id}": {
      "patch": {
        "tags": [
          "admin"
        ],
        "summary": "Update User",
        "operationId": "update_user_api_v1_admin_users__user_id__patch",
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "User Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserInfo"
                }
              }
            }
          },
          "400": {
            "description": "Invalid change"
          },
          "404": {
            "description": "No such user"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Event": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "UUIDv7, generated by the client"
          },
          "device_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Device Id"
          },
          "profile_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Profile Id"
          },
          "entry_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Entry Id"
          },
          "direction": {
            "type": "string",
            "enum": [
              "src_to_tr",
              "tr_to_src"
            ],
            "title": "Direction"
          },
          "mode": {
            "type": "string",
            "enum": [
              "flashcard",
              "typed",
              "choice",
              "parent"
            ],
            "title": "Mode"
          },
          "correct": {
            "type": "boolean",
            "title": "Correct"
          },
          "response_ms": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 3600000.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Response Ms"
          },
          "ts": {
            "type": "string",
            "format": "date-time",
            "title": "Ts",
            "description": "client time of the answer"
          }
        },
        "type": "object",
        "required": [
          "id",
          "device_id",
          "profile_id",
          "entry_id",
          "direction",
          "mode",
          "correct",
          "ts"
        ],
        "title": "Event",
        "description": "One answer. Immutable; the learning state is computed from all events."
      },
      "EventBatch": {
        "properties": {
          "events": {
            "items": {
              "$ref": "#/components/schemas/Event"
            },
            "type": "array",
            "maxItems": 500,
            "title": "Events"
          }
        },
        "type": "object",
        "required": [
          "events"
        ],
        "title": "EventBatch"
      },
      "EventPage": {
        "properties": {
          "events": {
            "items": {
              "$ref": "#/components/schemas/StoredEvent"
            },
            "type": "array",
            "title": "Events"
          },
          "next_since": {
            "type": "integer",
            "title": "Next Since",
            "description": "pass as `since` for the next request"
          },
          "more": {
            "type": "boolean",
            "title": "More"
          }
        },
        "type": "object",
        "required": [
          "events",
          "next_since",
          "more"
        ],
        "title": "EventPage"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "title": "Health"
      },
      "JsonValue": {},
      "LoginRequest": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest"
      },
      "Me": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "username": {
            "type": "string",
            "title": "Username"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "learner"
            ],
            "title": "Role"
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name",
            "description": "shown in greetings; the synced setting 'display_name'"
          }
        },
        "type": "object",
        "required": [
          "id",
          "username",
          "role"
        ],
        "title": "Me"
      },
      "PasswordChange": {
        "properties": {
          "current_password": {
            "type": "string",
            "maxLength": 1024,
            "title": "Current Password"
          },
          "new_password": {
            "type": "string",
            "maxLength": 1024,
            "title": "New Password"
          }
        },
        "type": "object",
        "required": [
          "current_password",
          "new_password"
        ],
        "title": "PasswordChange"
      },
      "ProfileSummary": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "source_lang": {
            "type": "string",
            "title": "Source Lang"
          },
          "required_translation_lang": {
            "type": "string",
            "title": "Required Translation Lang"
          },
          "translation_langs": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Translation Langs"
          },
          "revision": {
            "type": "integer",
            "title": "Revision"
          },
          "etag": {
            "type": "string",
            "title": "Etag"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "source_lang",
          "required_translation_lang",
          "translation_langs",
          "revision",
          "etag"
        ],
        "title": "ProfileSummary"
      },
      "Rejected": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "reason": {
            "type": "string",
            "enum": [
              "unknown_profile",
              "unknown_entry",
              "id_conflict"
            ],
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "id",
          "reason"
        ],
        "title": "Rejected"
      },
      "Setting": {
        "properties": {
          "key": {
            "type": "string",
            "title": "Key"
          },
          "value": {
            "$ref": "#/components/schemas/JsonValue"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "key",
          "value",
          "updated_at"
        ],
        "title": "Setting"
      },
      "SettingWrite": {
        "properties": {
          "value": {
            "$ref": "#/components/schemas/JsonValue"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At",
            "description": "client time of the change"
          }
        },
        "type": "object",
        "required": [
          "value",
          "updated_at"
        ],
        "title": "SettingWrite"
      },
      "StoredEvent": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "UUIDv7, generated by the client"
          },
          "device_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Device Id"
          },
          "profile_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Profile Id"
          },
          "entry_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Entry Id"
          },
          "direction": {
            "type": "string",
            "enum": [
              "src_to_tr",
              "tr_to_src"
            ],
            "title": "Direction"
          },
          "mode": {
            "type": "string",
            "enum": [
              "flashcard",
              "typed",
              "choice",
              "parent"
            ],
            "title": "Mode"
          },
          "correct": {
            "type": "boolean",
            "title": "Correct"
          },
          "response_ms": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 3600000.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Response Ms"
          },
          "ts": {
            "type": "string",
            "format": "date-time",
            "title": "Ts",
            "description": "client time of the answer"
          },
          "server_seq": {
            "type": "integer",
            "title": "Server Seq"
          },
          "received_at": {
            "type": "string",
            "format": "date-time",
            "title": "Received At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "device_id",
          "profile_id",
          "entry_id",
          "direction",
          "mode",
          "correct",
          "ts",
          "server_seq",
          "received_at"
        ],
        "title": "StoredEvent"
      },
      "UploadResult": {
        "properties": {
          "accepted": {
            "type": "integer",
            "title": "Accepted"
          },
          "duplicates": {
            "type": "integer",
            "title": "Duplicates"
          },
          "rejected": {
            "items": {
              "$ref": "#/components/schemas/Rejected"
            },
            "type": "array",
            "title": "Rejected"
          }
        },
        "type": "object",
        "required": [
          "accepted",
          "duplicates",
          "rejected"
        ],
        "title": "UploadResult"
      },
      "UserCreate": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 64,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 1024,
            "title": "Password"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "learner"
            ],
            "title": "Role",
            "default": "learner"
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 256
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "profiles": {
            "items": {
