# Capsa API image. Build from the repository root:
#   podman build -f api/Containerfile -t localhost/capsa-api:dev .
FROM docker.io/library/python:3.12-slim AS build
COPY --from=ghcr.io/astral-sh/uv:0.13.7 /uv /usr/local/bin/uv
# The venv is built at its final path: uv writes absolute paths into script shebangs.
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/app/.venv
WORKDIR /src
COPY pyproject.toml uv.lock ./
COPY schemas/ schemas/
COPY api/ api/
RUN uv sync --frozen --no-dev --no-editable --package capsa

FROM docker.io/library/python:3.12-slim
RUN useradd --uid 10001 --home-dir /app --no-create-home capsa
COPY --from=build /app/.venv /app/.venv
ENV PATH=/app/.venv/bin:$PATH PYTHONUNBUFFERED=1
USER capsa
WORKDIR /app
EXPOSE 8000
# Health: GET /api/v1/health (probed by the pod spec; OCI images carry no HEALTHCHECK).
# Only reachable from inside the pod; the reverse proxy forwards to it.
CMD ["uvicorn", "capsa.app:app", "--host", "127.0.0.1", "--port", "8000", \
     "--proxy-headers", "--forwarded-allow-ips", "127.0.0.1"]
