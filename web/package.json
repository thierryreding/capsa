{
  "name": "capsa-web",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "gen:api": "openapi-typescript ../schemas/openapi.json -o src/lib/api/schema.d.ts",
    "gen:profile": "json2ts -i ../schemas/profile.schema.json -o src/lib/api/profile.d.ts --no-additionalProperties",
    "gen": "npm run gen:api && npm run gen:profile",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "@vite-pwa/assets-generator": "^2.0.0",
    "fake-indexeddb": "^6.2.8",
    "json-schema-to-typescript": "^16.0.0",
    "openapi-typescript": "^7.13.0",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "dexie": "^4.4.7",
    "openapi-fetch": "^0.17.0"
  }
}
