{
  "description": "Leitner test vectors (SPEC 7). Times are ms since epoch (UTC). For each scenario, computing the states from `events` must give `states`; `due` lists card keys that are due at `now`. Keys are 'profile|entry|direction'.",
  "config": {"intervalsDays": [0, 1, 3, 7, 21], "utcOffsetMinutes": 60},
  "scenarios": [
    {
      "name": "first correct answer moves a new card to box 2, due the next calendar day",
      "events": [
        {"id": "01", "profile_id": "p", "entry_id": "a", "direction": "src_to_tr", "correct": true, "ts": 1800000000000}
      ],
      "states": {
        "p|a|src_to_tr": {"box": 2, "lastAt": 1800000000000, "lastCorrect": true, "correctCount": 1, "wrongCount": 0}
      },
      "checks": [
        {"now": 1800000000000, "due": [], "why": "09:00 CET, just answered"},
        {"now": 1800053940000, "due": [], "why": "23:59 CET, same day"},
        {"now": 1800055800000, "due": ["p|a|src_to_tr"], "why": "00:30 CET, next local day"}
      ]
    },
    {
      "name": "calendar days, not 24 hours: an evening answer is due the next morning",
      "events": [
        {"id": "01", "profile_id": "p", "entry_id": "a", "direction": "src_to_tr", "correct": true, "ts": 1799956800000}
      ],
      "states": {
        "p|a|src_to_tr": {"box": 2, "lastAt": 1799956800000, "lastCorrect": true, "correctCount": 1, "wrongCount": 0}
      },
      "checks": [
        {"now": 1799960400000, "due": [], "why": "22:00 CET, same day"},
        {"now": 1799996400000, "due": ["p|a|src_to_tr"], "why": "08:00 CET the next day, only 11 hours later"}
      ]
    },
    {
      "name": "wrong answer resets to box 1, due again immediately",
      "events": [
        {"id": "01", "profile_id": "p", "entry_id": "a", "direction": "src_to_tr", "correct": true, "ts": 1800000000000},
        {"id": "02", "profile_id": "p", "entry_id": "a", "direction": "src_to_tr", "correct": true, "ts": 1800100000000},
        {"id": "03", "profile_id": "p", "entry_id": "a", "direction": "src_to_tr", "correct": false, "ts": 1800400000000}
      ],
      "states": {
        "p|a|src_to_tr": {"box": 1, "lastAt": 1800400000000, "lastCorrect": false, "correctCount": 2, "wrongCount": 1}
      },
      "checks": [{"now": 1800400000001, "due": ["p|a|src_to_tr"]}]
    },
    {
      "name": "box 5 is the top; directions are separate cards",
      "events": [
        {"id": "01", "profile_id": "p", "entry_id": "a", "direction": "src_to_tr", "correct": true, "ts": 1800000000000},
        {"id": "02", "profile_id": "p", "entry_id": "a", "direction": "src_to_tr", "correct": true, "ts": 1800100000000},
        {"id": "03", "profile_id": "p", "entry_id": "a", "direction": "src_to_tr", "correct": true, "ts": 1800200000000},
        {"id": "04", "profile_id": "p", "entry_id": "a", "direction": "src_to_tr", "correct": true, "ts": 1800300000000},
        {"id": "05", "profile_id": "p", "entry_id": "a", "direction": "src_to_tr", "correct": true, "ts": 1800400000000},
        {"id": "06", "profile_id": "p", "entry_id": "a", "direction": "tr_to_src", "correct": false, "ts": 1800400000000}
      ],
      "states": {
        "p|a|src_to_tr": {"box": 5, "lastAt": 1800400000000, "lastCorrect": true, "correctCount": 5, "wrongCount": 0},
        "p|a|tr_to_src": {"box": 1, "lastAt": 1800400000000, "lastCorrect": false, "correctCount": 0, "wrongCount": 1}
      },
      "checks": [
        {"now": 1802100000000, "due": ["p|a|tr_to_src"], "why": "box 5 waits 21 days"},
        {"now": 1802300000000, "due": ["p|a|src_to_tr", "p|a|tr_to_src"]}
      ]
    },
    {
      "name": "events are ordered by time, then id, regardless of arrival order",
      "events": [
        {"id": "02", "profile_id": "p", "entry_id": "a", "direction": "src_to_tr", "correct": false, "ts": 1800000000000},
        {"id": "03", "profile_id": "p", "entry_id": "a", "direction": "src_to_tr", "correct": true, "ts": 1800100000000},
        {"id": "01", "profile_id": "p", "entry_id": "a", "direction": "src_to_tr", "correct": true, "ts": 1800000000000}
      ],
      "states": {
        "p|a|src_to_tr": {"box": 2, "lastAt": 1800100000000, "lastCorrect": true, "correctCount": 2, "wrongCount": 1}
      },
      "checks": []
    },
    {
      "name": "duplicate events count once",
      "events": [
        {"id": "01", "profile_id": "p", "entry_id": "a", "direction": "src_to_tr", "correct": true, "ts": 1800000000000},
        {"id": "01", "profile_id": "p", "entry_id": "a", "direction": "src_to_tr", "correct": true, "ts": 1800000000000, "received_at": 1800000500000}
      ],
      "states": {
        "p|a|src_to_tr": {"box": 2, "lastAt": 1800000000000, "lastCorrect": true, "correctCount": 1, "wrongCount": 0}
      },
      "checks": []
    },
    {
      "name": "a client clock more than a day ahead is replaced by received_at",
      "events": [
        {"id": "01", "profile_id": "p", "entry_id": "a", "direction": "src_to_tr", "correct": true, "ts": 1803000000000, "received_at": 1800000000000},
        {"id": "02", "profile_id": "p", "entry_id": "a", "direction": "src_to_tr", "correct": false, "ts": 1800500000000, "received_at": 1800500000000}
      ],
      "states": {
        "p|a|src_to_tr": {"box": 1, "lastAt": 1800500000000, "lastCorrect": false, "correctCount": 1, "wrongCount": 1}
      },
      "checks": []
    },
    {
      "name": "a client clock less than a day ahead is kept",
      "events": [
        {"id": "01", "profile_id": "p", "entry_id": "a", "direction": "src_to_tr", "correct": true, "ts": 1800080000000, "received_at": 1800000000000}
      ],
      "states": {
        "p|a|src_to_tr": {"box": 2, "lastAt": 1800080000000, "lastCorrect": true, "correctCount": 1, "wrongCount": 0}
      },
      "checks": []
    }
  ]
}
